# Railway 部署环境变量模板：将每项作为 Railway 服务变量添加，勿提交真实密钥。

# 认证（请替换为高强度随机值）
AUTH_USERNAME=admin
AUTH_PASSWORD=CHANGE_ME
AUTH_TOKEN_SECRET=CHANGE_ME

# 新用户注册通知（Discord Incoming Webhook；在 Railway Variables 中填写）
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Railway Volume 的挂载点为 /data。项目产物与 Vertex 凭据都将持久化在此卷内。
ARCREEL_DATA_DIR=/data/projects
ARCREEL_LOG_FILE_DISABLED=true
TZ=Asia/Shanghai

# 在 Railway 服务变量中引用 PostgreSQL 服务：
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# Railway 无法提供 bubblewrap 所需的 Linux namespace 权限，使用 E2B 远程沙盒。
ARCREEL_AGENT_BACKEND=e2b
# E2B_API_KEY=在 Railway Variables 中填写
ARCREEL_E2B_TEMPLATE=base
ARCREEL_E2B_TIMEOUT_SECONDS=900
